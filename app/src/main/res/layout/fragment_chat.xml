<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_amoled">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/asset_dashboard_background" />

    <com.smartvision.ai.ui.common.NeonParticlesView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="34dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/chatBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_outline_button"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="SmartVision AI"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/success_neon"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_outline_button"
                android:contentDescription="More"
                android:padding="10dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestionChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/chatInputPanel"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_input_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_outline_button"
                android:contentDescription="Attachment"
                android:padding="9dp"
                android:src="@drawable/ic_attach" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:background="@color/transparent"
                android:hint="Type a message..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/chatCameraButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_outline_button"
                android:contentDescription="Camera"
                android:padding="9dp"
                android:src="@drawable/ic_camera" />

            <ImageButton
                android:id="@+id/voiceButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_outline_button"
                android:contentDescription="Voice"
                android:padding="9dp"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_fab"
                android:contentDescription="Send"
                android:padding="11dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
