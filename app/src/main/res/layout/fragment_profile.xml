<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <com.smartvision.ai.ui.ParticleBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/profileBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Back"
                    android:tint="@color/white" />

                <TextView
                    style="@style/TextAppearance.SmartVision.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Profile"
                    android:textSize="28sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/avatarView"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_circle_neon"
                    android:padding="18dp"
                    android:src="@drawable/ic_profile"
                    android:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nameText"
                        style="@style/TextAppearance.SmartVision.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ajith Kumar"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/emailText"
                        style="@style/TextAppearance.SmartVision.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Premium AI user" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/totalScansText"
                    style="@style/TextAppearance.SmartVision.Title"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:text="128\nTotal" />

                <TextView
                    android:id="@+id/objectsText"
                    style="@style/TextAppearance.SmartVision.Title"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:text="342\nObjects" />

                <TextView
                    android:id="@+id/ocrText"
                    style="@style/TextAppearance.SmartVision.Title"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:text="86\nOCR" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gradient_button"
                android:text="Open settings"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_logout"
                android:text="Sign Out"
                android:textColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
