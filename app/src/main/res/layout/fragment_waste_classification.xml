<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.smartvision.ai.ui.DetectionOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        style="@style/TextAppearance.SmartVision.Title"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#D9050915"
        android:gravity="center"
        android:text="Waste Classifier" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6050915"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/resultText"
            style="@style/TextAppearance.SmartVision.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:text="Detected category will appear here."
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tipText"
            style="@style/TextAppearance.SmartVision.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tip: keep the object centered for best classification." />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_gradient_button"
            android:text="Classify Waste"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
