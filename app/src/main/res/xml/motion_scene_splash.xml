<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@+id/start"
        motion:duration="1800"
        motion:motionInterpolator="easeInOut" />

    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/logoEye">
            <Transform
                android:alpha="0"
                android:scaleX="0.78"
                android:scaleY="0.78" />
        </Constraint>
        <Constraint android:id="@id/splashTitle">
            <Transform android:alpha="0" />
        </Constraint>
        <Constraint android:id="@id/splashSubtitle">
            <Transform android:alpha="0" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/logoEye">
            <Transform
                android:alpha="1"
                android:scaleX="1.05"
                android:scaleY="1.05" />
        </Constraint>
        <Constraint android:id="@id/splashTitle">
            <Transform android:alpha="1" />
        </Constraint>
        <Constraint android:id="@id/splashSubtitle">
            <Transform android:alpha="1" />
        </Constraint>
    </ConstraintSet>
</MotionScene>
