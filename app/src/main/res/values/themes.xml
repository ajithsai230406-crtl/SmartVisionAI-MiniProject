<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartVisionAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_neon</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorOnSecondary">@color/navy_950</item>
        <item name="colorTertiary">@color/purple_neon</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:navigationBarColor">@color/navy_950</item>
        <item name="android:statusBarColor">@color/navy_950</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.SmartVision.Button</item>
        <item name="materialCardViewStyle">@style/Widget.SmartVision.Card</item>
    </style>

    <style name="Widget.SmartVision" parent="" />

    <style name="Widget.SmartVision.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.SmartVision.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
